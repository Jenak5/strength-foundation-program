# Required. Checked by /api/state before any read or write of the training log.
APP_PASSCODE=

# Preferred store. Created in the Vercel dashboard:
# Storage → Blob → private store connected to this project.
# Vercel injects this token when the store is connected.
BLOB_READ_WRITE_TOKEN=

# Used only when Blob is not configured.
# Marketplace: vercel integration add upstash
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Legacy Vercel KV names are also accepted for Upstash.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
